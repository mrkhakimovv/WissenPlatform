{
  "$schema": "https://raw.githubusercontent.com/google/google-ai-studio-agent-blueprints/main/schemas/firebase-blueprint-schema.json",
  "auth": {
    "enabled": false
  },
  "firestore": {
    "collections": [
      {
        "name": "users",
        "document": {
          "fields": [
            { "name": "username", "type": "string" },
            { "name": "password", "type": "string" },
            { "name": "role", "type": "string" },
            { "name": "fullName", "type": "string" },
            { "name": "groupId", "type": "string", "optional": true },
            { "name": "subject", "type": "string", "optional": true }
          ]
        },
        "description": "Store users (students, teachers, admins)"
      },
      {
        "name": "groups",
        "document": {
          "fields": [
            { "name": "name", "type": "string" },
            { "name": "teacherName", "type": "string" },
            { "name": "subject", "type": "string" },
            { "name": "createdAt", "type": "string" }
          ]
        },
        "description": "Store classes/groups"
      },
      {
        "name": "payments",
        "document": {
          "fields": [
            { "name": "studentId", "type": "string" },
            { "name": "amount", "type": "number" },
            { "name": "date", "type": "string" },
            { "name": "status", "type": "string" }
          ]
        },
        "description": "Store students payments"
      },
      {
        "name": "attendance",
        "document": {
          "fields": [
            { "name": "studentId", "type": "string" },
            { "name": "date", "type": "string" },
            { "name": "present", "type": "boolean" }
          ]
        },
        "description": "Store students attendance"
      },
      {
        "name": "subjects",
        "document": {
          "fields": [
            { "name": "name", "type": "string" },
            { "name": "createdAt", "type": "string" }
          ]
        },
        "description": "Store subjects"
      }
    ]
  }
}

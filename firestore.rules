rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'teacher');
    }

    match /users/{userId} {
      allow read, write: if request.auth != null; // Everyone authenticated can read/write users for now
    }

    match /groups/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /subjects/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }

    match /news/{document=**} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if request.auth != null;
    }

    match /exams/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /homeworks/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /submissions/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /schedules/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    match /tests/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /testCategories/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /exam_results/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /sat_lessons/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
